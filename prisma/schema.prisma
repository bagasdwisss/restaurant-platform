generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Table {
  id          Int          @id @default(autoincrement())
  tableNumber String       @unique
  capacity    Int          @default(4)
  qrToken     String       @unique
  status      String       @default("available") // available, occupied, reserved
  area        String       @default("Indoor")    // Indoor, Outdoor, Lantai 2
  orders      Order[]
  waiterCalls WaiterCall[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id        Int            @id @default(autoincrement())
  username  String         @unique
  email     String         @unique
  password  String
  name      String
  role      String         @default("user") // admin, kasir, user
  uniqueKey String?        @unique
  phone     String?
  avatar    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  shifts    CashierShift[]
  orders    Order[]
}

model CashierShift {
  id              Int       @id @default(autoincrement())
  cashierName     String    @default("Kasir Utama")
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  startCash       Float
  endCashActual   Float?
  endCashExpected Float?
  variance        Float?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  status          String    @default("open") // open, closed
  orders          Order[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  menus     Menu[]
}

model Menu {
  id             Int             @id @default(autoincrement())
  categoryId     Int
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Float
  image          String?
  country        String?         @default("Prancis")
  isAvailable    Boolean         @default(true)
  orderItems     OrderItem[]
  modifierGroups ModifierGroup[]
  recipes        Recipe[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ModifierGroup {
  id           Int              @id @default(autoincrement())
  menuId       Int?
  menu         Menu?            @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name         String
  minSelection Int              @default(0)
  maxSelection Int              @default(1) // 1 = Single choice, >1 = Multiple choice
  options      ModifierOption[]
}

model ModifierOption {
  id        Int           @id @default(autoincrement())
  groupId   Int
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  price     Float         @default(0)
}

model Order {
  id            Int          @id @default(autoincrement())
  orderNumber   String       @unique
  tableId       Int?
  table         Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  shiftId       Int?
  shift         CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String?
  customerPhone   String?
  reservationDate String?      // e.g. "2026-10-14"
  reservationTime String?      // e.g. "19:30 - Grand Dinner Session"
  guestCount      Int?         @default(2)
  specialRequests String?
  orderType       String       @default("dine_in") // dine_in, takeaway, reservation
  status        String       @default("pending") // pending, confirmed, preparing, served, completed, cancelled, voided
  subtotal      Float        @default(0)
  taxAmount     Float        @default(0)
  serviceCharge Float        @default(0)
  totalAmount   Float        @default(0)
  paymentStatus String       @default("unpaid")  // unpaid, paid
  paymentMethod String?                          // cash, qris, debit
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderItem {
  id               Int       @id @default(autoincrement())
  orderId          Int
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuId           Int
  menu             Menu      @relation(fields: [menuId], references: [id], onDelete: Restrict)
  quantity         Int       @default(1)
  unitPrice        Float
  subtotal         Float
  notes            String?
  isVoided         Boolean   @default(false)
  voidReason       String?
  selectedVariants String?   // JSON string of selected options: [{group: '...', option: '...', extraPrice: 0}]
}

model Payment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      String   // cash, qris, debit
  amountPaid  Float
  changeAmount Float   @default(0)
  paymentRef  String?
  createdAt   DateTime @default(now())
}

model Ingredient {
  id            Int      @id @default(autoincrement())
  name          String
  unit          String   // gram, ml, pcs
  stockQuantity Float    @default(0)
  minStock      Float    @default(10)
  recipes       Recipe[]
}

model Recipe {
  id             Int        @id @default(autoincrement())
  menuId         Int
  menu           Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredientId   Int
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityNeeded Float      // Quantity needed per 1 portion
}

model WaiterCall {
  id          Int      @id @default(autoincrement())
  tableId     Int
  table       Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableNumber String
  status      String   @default("pending") // pending, completed
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      String   @default("System")
  action    String
  details   String
  createdAt DateTime @default(now())
}
